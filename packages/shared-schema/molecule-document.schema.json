{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.local/schema/molecule-document.schema.json",
  "title": "MoleculeDocument",
  "type": "object",
  "required": [
    "id",
    "name",
    "document_kind",
    "source",
    "calculation",
    "coordinate_unit",
    "charge",
    "multiplicity",
    "atoms",
    "bonds",
    "frozen_atom_indices",
    "vibrational_modes"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "document_kind": {
      "type": "string",
      "const": "structure",
      "description": "Normalized document kind used to route document-specific UI behavior."
    },
    "source": {
      "description": "Source file metadata for documents opened from a file path.",
      "anyOf": [
        {
          "type": "object",
          "required": ["path", "filename", "filetype"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "filename": { "type": "string", "minLength": 1 },
            "filetype": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "calculation": {
      "description": "Calculation metadata for parsed quantum-chemistry output documents.",
      "anyOf": [
        {
          "type": "object",
          "required": ["program", "normal_termination"],
          "properties": {
            "program": {
              "type": "string",
              "enum": ["gaussian", "orca"]
            },
            "normal_termination": {
              "type": "boolean",
              "description": "CHEMSMART parser normal_termination value."
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "coordinate_unit": {
      "type": "string",
      "const": "angstrom",
      "description": "Unit used by all Cartesian atom coordinates."
    },
    "charge": {
      "type": ["integer", "null"],
      "description": "Total molecular charge, or null when unknown."
    },
    "multiplicity": {
      "type": ["integer", "null"],
      "description": "Spin multiplicity, or null when unknown."
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "element", "x", "y", "z"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "element": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "bonds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atom1", "atom2"],
        "properties": {
          "atom1": { "type": "integer", "minimum": 1 },
          "atom2": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "frozen_atom_indices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "1-based atom indices currently frozen for constrained edits or future input generation."
    },
    "vibrational_modes": {
      "type": "array",
      "description": "CHEMSMART-normalized vibrational modes. Frequencies are in cm^-1; displacement values come from CHEMSMART parser normal-mode output.",
      "items": {
        "type": "object",
        "required": [
          "index",
          "frequency_cm_minus_1",
          "is_imaginary",
          "reduced_mass_amu",
          "force_constant_mdyne_per_angstrom",
          "ir_intensity_km_per_mol",
          "symmetry",
          "displacements"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based vibrational mode index."
          },
          "frequency_cm_minus_1": {
            "type": "number",
            "description": "Vibrational frequency in cm^-1."
          },
          "is_imaginary": {
            "type": "boolean",
            "description": "True when frequency_cm_minus_1 is negative."
          },
          "reduced_mass_amu": {
            "type": ["number", "null"],
            "description": "Reduced mass in atomic mass units when available."
          },
          "force_constant_mdyne_per_angstrom": {
            "type": ["number", "null"],
            "description": "Force constant in mDyne/Angstrom when available."
          },
          "ir_intensity_km_per_mol": {
            "type": ["number", "null"],
            "description": "IR intensity in km/mol when available."
          },
          "symmetry": {
            "type": ["string", "null"],
            "description": "Mode symmetry label when available."
          },
          "displacements": {
            "type": "array",
            "description": "Per-atom normal-mode displacement vectors keyed by 1-based atom index.",
            "items": {
              "type": "object",
              "required": ["atom_index", "x", "y", "z"],
              "properties": {
                "atom_index": { "type": "integer", "minimum": 1 },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
