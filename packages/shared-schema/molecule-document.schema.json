{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.local/schema/molecule-document.schema.json",
  "title": "MoleculeDocument",
  "type": "object",
  "required": [
    "id",
    "name",
    "document_kind",
    "coordinate_unit",
    "charge",
    "multiplicity",
    "atoms",
    "bonds"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "document_kind": {
      "type": "string",
      "const": "structure",
      "description": "Normalized document kind used to route document-specific UI behavior."
    },
    "coordinate_unit": {
      "type": "string",
      "const": "angstrom",
      "description": "Unit used by all Cartesian atom coordinates."
    },
    "charge": {
      "type": ["integer", "null"],
      "description": "Total molecular charge, or null when unknown."
    },
    "multiplicity": {
      "type": ["integer", "null"],
      "description": "Spin multiplicity, or null when unknown."
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "element", "x", "y", "z"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "element": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "bonds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atom1", "atom2"],
        "properties": {
          "atom1": { "type": "integer", "minimum": 1 },
          "atom2": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
