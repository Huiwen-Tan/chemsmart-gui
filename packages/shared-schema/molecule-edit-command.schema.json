{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.local/schema/molecule-edit-command.schema.json",
  "title": "MoleculeEditCommand",
  "description": "Explicit molecule edit commands. Atom indices are 1-based and Cartesian coordinates are in Angstrom.",
  "oneOf": [
    {
      "title": "SetAtomPositionCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "atom_index",
        "position",
        "coordinate_unit"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "set_atom_position"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "atom_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based atom index in the target molecule document."
        },
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "additionalProperties": false
        },
        "coordinate_unit": {
          "type": "string",
          "const": "angstrom",
          "description": "Unit used by the Cartesian target position."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "AddBondCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "atom1_index",
        "atom2_index"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "add_bond"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "atom1_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based first atom index in the target molecule document."
        },
        "atom2_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based second atom index in the target molecule document."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "SetAtomDistanceCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "atom1_index",
        "atom2_index",
        "distance",
        "coordinate_unit"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "set_atom_distance"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "atom1_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based first atom index in the target molecule document."
        },
        "atom2_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based second atom index in the target molecule document."
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Target atom distance in Angstrom."
        },
        "coordinate_unit": {
          "type": "string",
          "const": "angstrom",
          "description": "Unit used by the target distance."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "RemoveBondCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "atom1_index",
        "atom2_index"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "remove_bond"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "atom1_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based first atom index in the target molecule document."
        },
        "atom2_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based second atom index in the target molecule document."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "SetAtomAngleCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "atom1_index",
        "vertex_atom_index",
        "atom3_index",
        "angle_degrees"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "set_atom_angle"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "atom1_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based first atom index in the target molecule document."
        },
        "vertex_atom_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based vertex atom index in the target molecule document."
        },
        "atom3_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based third atom index in the target molecule document."
        },
        "angle_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180,
          "description": "Target atom angle in degrees."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "AddAtomCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "element",
        "position",
        "coordinate_unit"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "add_atom"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "element": {
          "type": "string",
          "minLength": 1,
          "description": "Chemical element symbol for the new atom."
        },
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "additionalProperties": false
        },
        "coordinate_unit": {
          "type": "string",
          "const": "angstrom",
          "description": "Unit used by the Cartesian target position."
        }
      },
      "additionalProperties": false
    },
    {
      "title": "DeleteAtomsCommand",
      "type": "object",
      "required": [
        "command_type",
        "document_id",
        "atom_indices"
      ],
      "properties": {
        "command_type": {
          "type": "string",
          "const": "delete_atoms"
        },
        "document_id": { "type": "string", "minLength": 1 },
        "atom_indices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "1-based atom indices to delete."
        }
      },
      "additionalProperties": false
    }
  ]
}
